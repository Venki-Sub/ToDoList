<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         x:Class="ToDoList.MainPage"
                         Shell.NavBarIsVisible="False"
                         BackgroundColor="#FFF8F3">

    <ContentPage.Resources>
        <Style TargetType="Label" x:Key="TitleLabelStyle">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#2D2D2D" />
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="BackgroundColor" Value="#FF7043" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *" Padding="20">
        <!-- Top bar -->
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Fill" VerticalOptions="Center" Padding="4">
            <VerticalStackLayout HorizontalOptions="StartAndExpand">
                <Label Text="Hello Buddy!" Style="{StaticResource TitleLabelStyle}" />
                <Label Text="Organize your day, one task at a time" FontSize="12" TextColor="#6B6B6B" />
            </VerticalStackLayout>
            <Border Padding="6" Background="#FFFFFF" HorizontalOptions="End">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Label Text="SF" FontAttributes="Bold" TextColor="#FF7043" />
            </Border>
        </HorizontalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1" VerticalOptions="FillAndExpand">
            <VerticalStackLayout Spacing="18">
                <!-- Hero card -->
                <Border x:Name="HeroCard" Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF8A65" Offset="0.0" />
                            <GradientStop Color="#FF7043" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding DailyQuote}" FontSize="20" TextColor="White" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding QuoteAuthor}" FontSize="14" TextColor="#FFECE6" HorizontalOptions="End" />
                        <HorizontalStackLayout Spacing="12" HorizontalOptions="End">
                            <Button x:Name="CtaButton" Text="Open To‑Do" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NavigateToDoCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Quick actions -->
                <HorizontalStackLayout Spacing="12" HorizontalOptions="FillAndExpand">
                    <Border Padding="12" Background="#FFFFFF" HorizontalOptions="FillAndExpand">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout VerticalOptions="Center" Spacing="12">
                            <Label Text="🗒️" FontSize="22" />
                            <VerticalStackLayout>
                                <Label Text="My Tasks" FontAttributes="Bold" />
                                <Label Text="Open your to-do lists" FontSize="12" TextColor="#7A7A7A" />
                            </VerticalStackLayout>
                            <Button Text="Open" Command="{Binding NavigateToDoCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalOptions="EndAndExpand" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border Padding="12" Background="#FFFFFF" HorizontalOptions="FillAndExpand">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout VerticalOptions="Center" Spacing="12">
                            <Label Text="✨" FontSize="22" />
                            <VerticalStackLayout>
                                <Label Text="Daily Quotes" FontAttributes="Bold" />
                                <Label Text="Inspire yourself every day" FontSize="12" TextColor="#7A7A7A" />
                            </VerticalStackLayout>
                            <Button Text="View" HorizontalOptions="EndAndExpand" />
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>

                <!-- Spacer / tips -->
                <Border Padding="12" Background="#FFFFFF">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="Tip: Tap 'Open To‑Do' to manage tasks. Add, complete, and organize with ease." FontSize="13" TextColor="#6B6B6B" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
