<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Base ===== -->
    <Color x:Key="PageBg">#F5F6FA</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Ink">#1E1F2B</Color>
    <Color x:Key="InkSoft">#5C5F70</Color>
    <Color x:Key="InkMuted">#9A9DAE</Color>
    <Color x:Key="Slate">#4A5576</Color>
    <Color x:Key="Outline">#E3E5EE</Color>
    <Color x:Key="ShadowColor">#7A82A8</Color>

    <!-- ===== Pastel card tints ===== -->
    <Color x:Key="Lavender">#D8DCF2</Color>
    <Color x:Key="Lilac">#E6DDF8</Color>
    <Color x:Key="Cream">#F3EEE8</Color>
    <Color x:Key="Mist">#E9EAEE</Color>
    <Color x:Key="Blush">#FBEEF5</Color>
    <Color x:Key="Sky">#DCE6F8</Color>
    <Color x:Key="HistoryBg">#F1F2F5</Color>

    <!-- ===== Header + CTA gradients ===== -->
    <Color x:Key="HeaderStart">#B4AEDC</Color>
    <Color x:Key="HeaderEnd">#A9BAB4</Color>
    <Color x:Key="CtaStart">#BBA8EA</Color>
    <Color x:Key="CtaEnd">#9CC9A8</Color>

    <!-- ===== Semantic ===== -->
    <Color x:Key="Primary">#7B6FD0</Color>
    <Color x:Key="Success">#4CAF7A</Color>
    <Color x:Key="Warning">#E9A23B</Color>
    <Color x:Key="Danger">#E05A5A</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="SlateBrush" Color="{StaticResource Slate}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource Outline}" />
    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource ShadowColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />

    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0.8">
        <GradientStop Color="{StaticResource HeaderStart}" Offset="0" />
        <GradientStop Color="{StaticResource HeaderEnd}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CtaGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource CtaStart}" Offset="0" />
        <GradientStop Color="{StaticResource CtaEnd}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OnboardingGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F4F6F8" Offset="0" />
        <GradientStop Color="#E9EDF0" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
