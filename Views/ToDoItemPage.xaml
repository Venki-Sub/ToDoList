<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToDoList.Views.ToDoItemPage"
             xmlns:viewmodel="clr-namespace:ToDoList.ViewModels" 
             xmlns:model="clr-namespace:ToDoList.Models"
             Title="To-Do List">

    <ContentPage.Background>
        <StaticResourceExtension Key="AppGradientBrush" />
    </ContentPage.Background>

    <ContentPage.Resources>
        <!-- Make most labels on this page use white on the dark gradient background -->
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource WhiteBrush}" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid Padding="20" RowDefinitions="Auto, * , Auto">
            <!-- Header / Date -->
            <VerticalStackLayout Grid.Row="0" Spacing="6">
                <Label Text="2019" FontSize="20" TextColor="{StaticResource WhiteBrush}" Opacity="0.9" />
                <Label Text="April 8th" FontSize="28" Style="{StaticResource HeadlineLarge}" />
            </VerticalStackLayout>

            <!-- Task list -->
            <CollectionView Grid.Row="1" ItemsSource="{Binding ToDoItems}" Margin="0,14,0,14">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:TodoItem">
                        <Border Style="{StaticResource TaskCardStyle}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Padding="10" Spacing="12" VerticalOptions="Center">
                                <Border Padding="8" Background="{StaticResource CardSurfaceBrush}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="📘" FontSize="20" TextColor="{StaticResource WhiteBrush}" />
                                </Border>
                                <VerticalStackLayout VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                                    <Label Text="{Binding ItemName}" Style="{StaticResource TaskTitle}" />
                                    <Label Text="{Binding Description}" FontSize="12" TextColor="{StaticResource WhiteBrush}" Opacity="0.8" />
                                </VerticalStackLayout>
                                <VerticalStackLayout HorizontalOptions="End" VerticalOptions="Center">
                                    <Label Text="{Binding DueDate, StringFormat='{}{0:MM/dd/yyyy}'}" FontSize="12" TextColor="{StaticResource WhiteBrush}" Opacity="0.7" />
                                    <CheckBox IsChecked="{Binding IsCompleted}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToDetailCommand}" CommandParameter="{Binding .}" NumberOfTapsRequired="1" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Bottom Add CTA -->
            <HorizontalStackLayout Grid.Row="2" Padding="0,8,0,0">
                <Button Text="ADD NEW TASK" Style="{StaticResource PrimaryCTA}" Command="{Binding NavigateToNewCommand}" HorizontalOptions="FillAndExpand" />
            </HorizontalStackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>
