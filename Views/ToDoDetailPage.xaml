<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         x:Class="ToDoList.Views.ToDoDetailPage"
                         Title="Task Details"
                         BackgroundColor="#F3F6FA">

    <ContentPage.Resources>
        <Style TargetType="Label" x:Key="HeaderTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#222" />
        </Style>
        <Style TargetType="Label" x:Key="SubtleText">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="#6B6B6B" />
        </Style>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="16" Spacing="12">
        <!-- Header with back -->
        <Grid ColumnDefinitions="Auto, *" VerticalOptions="Start">
            <Button Text="←" BackgroundColor="Transparent" FontSize="18" Clicked="OnBackClicked" />
            <Label Text="Task Details" Grid.Column="1" VerticalOptions="Center" Style="{StaticResource HeaderTitle}" />
        </Grid>

        <ScrollView>
            <VerticalStackLayout Spacing="14">
                <!-- Card -->
                <Border Background="#FFFFFF" Padding="16" Margin="0,6" >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">
                        <!-- Title -->
                        <Label Text="{Binding TaskName}" FontSize="22" FontAttributes="Bold" TextColor="#111" LineBreakMode="TailTruncation" />

                        <!-- Meta row: priority, due date, completed -->
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Border Background="#EEF6FF" Padding="6,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Priority}" FontSize="12" TextColor="#2B6CB0" />
                            </Border>

                            <Border Background="#FFF7E6" Padding="6,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="{Binding DueDate, StringFormat='{}{0:MMM d, yyyy}'}" FontSize="12" TextColor="#E65100" />
                            </Border>

                            <HorizontalStackLayout HorizontalOptions="EndAndExpand" Spacing="8" VerticalOptions="Center">
                                <Label Text="Completed" Style="{StaticResource SubtleText}" VerticalOptions="Center" />
                                <Switch IsToggled="{Binding IsCompleted}" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" />

                        <!-- Description -->
                        <Label Text="Description" FontAttributes="Bold" FontSize="14" />
                        <Label Text="{Binding Description}" FontSize="16" TextColor="#333" />

                        <!-- Actions -->
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="End" Padding="0,6,0,0">
                            <Button Text="Edit" BackgroundColor="#4A90E2" TextColor="White" Style="{StaticResource ActionButton}" />
                            <Button Text="Delete" BackgroundColor="#F8F8F8" TextColor="#D32F2F" Style="{StaticResource ActionButton}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Tip / Footer -->
                <Label Text="Tip: Use Edit to change the task or toggle Completed when finished." Style="{StaticResource SubtleText}" />
            </VerticalStackLayout>
        </ScrollView>
    </VerticalStackLayout>

</ContentPage>
